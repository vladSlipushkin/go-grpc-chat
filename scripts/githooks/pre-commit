#!/bin/sh
# Blocks a commit when staged Go files are not gofmt-ed, when a staged path
# matches the local deny-list .git/info/forbidden-paths, or when added lines
# fail scripts/githooks/check-text.
set -u

hooks_dir=$(dirname "$0")
git_dir=$(git rev-parse --git-dir)
status=0

staged() {
	git diff --cached --name-only --diff-filter=ACMR "$@"
}

# Check the staged blob, not the working tree, so partial staging is honoured.
unformatted=$(staged -- '*.go' | while IFS= read -r f; do
	if [ -n "$(git show ":$f" | gofmt -l)" ]; then
		echo "$f"
	fi
done)
if [ -n "$unformatted" ]; then
	echo "not gofmt-ed (run 'make fmt'):" >&2
	echo "$unformatted" >&2
	status=1
fi

paths_file="$git_dir/info/forbidden-paths"
if [ -f "$paths_file" ]; then
	patterns=$(grep -Ev '^(#|$)' "$paths_file")
	if [ -n "$patterns" ]; then
		bad=$(staged | grep -E -e "$patterns")
		if [ -n "$bad" ]; then
			echo "staged paths are on the local deny-list:" >&2
			echo "$bad" >&2
			status=1
		fi
	fi
fi

if ! git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' | "$hooks_dir/check-text"; then
	status=1
fi

exit $status
